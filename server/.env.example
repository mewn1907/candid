# ©️ Mewn
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=8080
HOST=localhost
# Comma-separated allowlist, e.g. https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# Rooms
ROOM_LIMIT_PER_IP=10
ROOM_EXPIRY_SECONDS=3600
MAX_PARTICIPANTS=2

# WebRTC (served to clients via GET /ice-servers)
STUN_SERVERS=stun:stun.l.google.com:19302
# TURN is used only when all three are set:
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# Abuse protection
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIME_WINDOW=60000
MAX_HTTP_BUFFER_SIZE=6000000
